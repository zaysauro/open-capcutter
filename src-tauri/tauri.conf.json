{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapCutter",
  "version": "0.2.0",
  "identifier": "app.capcutter.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CapCutter",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Local-first video editor",
    "longDescription": "Offline-capable local video editor."
  }
}
